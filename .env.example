# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다. 값을 채팅·메일·문서에 붙여넣지 않는다.

# [네이버 개발자센터] https://developers.naver.com > Application 등록
#   API 설정에서 '데이터랩(쇼핑인사이트)'와 '검색' 둘 다 선택
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# [네이버 검색광고] https://manage.searchad.naver.com > 도구 > API 사용 관리 (키워드 발굴용)
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
