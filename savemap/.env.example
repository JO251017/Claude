APP_ENV=local
APP_DEBUG=true

SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/savemap
SUPABASE_JWT_SECRET=change-me

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

KAKAO_REST_API_KEY=
DATA_GO_KR_KEY=
TOUR_API_KEY=
OPINET_API_KEY=
GEMINI_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=reports

SEARCH_DEFAULT_RADIUS_KM=3
SEARCH_MAX_RADIUS_KM=10
SEARCH_MAX_RESULTS=60
SEARCH_ROW_FETCH_LIMIT=500
RANK_SAVINGS_WEIGHT=0.7
RANK_TRUST_WEIGHT=0.3

# 콤마로 구분된 허용 origin 목록 (예: https://app.example.com,https://m.example.com)
# 비워두면 CORS 미들웨어를 아예 안 붙인다 — 프론트가 이 API와 같은 도메인일 때는
# 필요 없다.
CORS_ALLOWED_ORIGINS=

# 비워두면(기본값) Sentry를 초기화하지 않는다 — 값을 넣으면 바로 에러 트래킹이 켜진다.
SENTRY_DSN=
